# Congress.gov API key
CONGRESS_API_KEY=your_congress_api_key_here

# X API v2 credentials — OAuth 1.0a user context
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_SECRET=your_access_token_secret_here

# How often to check in local dev mode (minutes, default 15)
POLL_INTERVAL_MINUTES=15

# Set to "true" to log tweets without posting (safe for testing)
DRY_RUN=true
