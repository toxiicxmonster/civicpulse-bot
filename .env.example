# Congress.gov API key — required
CONGRESS_API_KEY=your_congress_api_key_here

# ── Posting platforms — configure one or both ────────────────────────────────

# X (Twitter) — requires Basic plan ($100/mo) at developer.x.com
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_SECRET=your_access_token_secret_here

# Bluesky — free. Create an App Password at bsky.app → Settings → App Passwords
BSKY_HANDLE=yourhandle.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Bot settings ──────────────────────────────────────────────────────────────

# How often to check (minutes). Default 15 locally; Render uses 15 via render.yaml
POLL_INTERVAL_MINUTES=15

# Directory for posted.json state file. Set to /data on Render (persistent disk mount)
DATA_DIR=

# Set to "true" to log posts without posting (safe for testing)
DRY_RUN=true

# Set to "false" to skip the breakdown image reply (saves an API call)
VOTE_IMAGE=true
